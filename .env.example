# Telegram BotFather token. AgentFlow auto-injects this into /workspace/.env
# from the project's BOT_TOKEN secret (auto-bot.ts). For local development,
# replace with your own token from @BotFather.
BOT_TOKEN=123456:REPLACE_WITH_REAL_BOT_TOKEN

# Public HTTPS URL of the frontend. AgentFlow auto-injects this from the
# project's preview URL (https://<slug>.proj.agentflow.website) — see PR-Y.
# For local dev, set via ngrok / tunnel since Telegram requires HTTPS.
PREVIEW_URL=https://example.proj.agentflow.website
